#!/bin/bash
# Print every compose sequence line that is active for this user: the file
# XCOMPOSEFILE points at (default ~/.XCompose), with its include lines followed
# the way libX11 and fcitx5 follow them. %L is the system table for the
# current locale, %H the home directory, %S the X11 locale root. When the
# user has no compose file at all, the system table alone is active.
#
# Usage: compose-dump [file]
#
# Bounds, all on the producer side because the shell collects the output
# whole: each file is read through head -c so no more than MAX_FILE_BYTES of
# it is ever seen, whatever its size, growth or line length; the total output
# passes through head -c MAX_OUTPUT_BYTES; include depth stops at 8; and the
# whole run sits under a timeout. Sizes are measured on the target of a
# symlink, not the link.
set -u
LOCALE_ROOT=/usr/share/X11/locale
MAX_FILE_BYTES=$((8 * 1024 * 1024))
MAX_OUTPUT_BYTES=$((4 * 1024 * 1024))
TIMEOUT_SECONDS=10

if [[ -z ${COMPOSE_DUMP_BOUNDED:-} ]]; then
  export COMPOSE_DUMP_BOUNDED=1
  # No deadline available means no dump: the shell must never wait on this.
  command -v timeout >/dev/null 2>&1 || { echo "compose-dump: timeout(1) is required" >&2; exit 1; }
  # bash "$0" rather than "$0": the copy in a plugin folder may have lost +x.
  timeout "$TIMEOUT_SECONDS" bash "$0" "$@" | head -c "$MAX_OUTPUT_BYTES"
  rc=${PIPESTATUS[0]}
  # Reaching the output cap is the bound working, not a failure: the inner
  # run stops itself on the first failed write (see dump), and where SIGPIPE
  # is delivered it reports 141. A timeout (124) stays visible.
  [[ $rc -eq 141 ]] && rc=0
  exit "$rc"
fi

system_table() {
  local loc="${LC_ALL:-${LC_CTYPE:-${LANG:-en_US.UTF-8}}}"
  local dir
  dir=$(awk -v l="$loc" '$2 == l { sub(/\/Compose$/, "", $1); print $1; exit }' "$LOCALE_ROOT/compose.dir" 2>/dev/null)
  [[ -n $dir && -f $LOCALE_ROOT/$dir/Compose ]] && { echo "$LOCALE_ROOT/$dir/Compose"; return; }
  echo "$LOCALE_ROOT/en_US.UTF-8/Compose"
}

declare -A seen

# A regular file, not a FIFO, device or socket (-f follows symlinks and is
# false for all of those), and not larger than the cap when measured on the
# file itself rather than a symlink to it.
readable_table() {
  local file="$1" size
  [[ -f $file ]] || return 1
  size=$(stat -L -c %s -- "$file" 2>/dev/null) || return 1
  (( size <= MAX_FILE_BYTES )) || { echo "compose-dump: skipping $file, larger than $MAX_FILE_BYTES bytes" >&2; return 1; }
  return 0
}

dump() {
  local file="$1" depth="$2"
  [[ $depth -lt 8 && -z ${seen[$file]:-} ]] || return 0
  readable_table "$file" || return 0
  seen[$file]=1
  local line target
  # head -c makes the size check a hard limit: a file that grows after the
  # check, or one long line, still yields at most MAX_FILE_BYTES.
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line =~ ^[[:space:]]*include[[:space:]]+\"([^\"]+)\" ]]; then
      target="${BASH_REMATCH[1]}"
      target="${target//%L/$SYSTEM_TABLE}"
      target="${target//%H/$HOME}"
      target="${target//%S/$LOCALE_ROOT}"
      dump "$target" $((depth + 1))
    elif [[ $line == *"<Multi_key>"*":"* ]]; then
      # A failed write means the consumer has taken its fill (the output cap
      # closed the pipe). Stop here; under systemd SIGPIPE is ignored, so the
      # write error is the only signal.
      printf '%s\n' "$line" 2>/dev/null || exit 0
    fi
  done < <(head -c "$MAX_FILE_BYTES" -- "$file" 2>/dev/null)
}

# The system table's path is the same for every include line; look it up once.
SYSTEM_TABLE=$(system_table)

start="${1:-${XCOMPOSEFILE:-$HOME/.XCompose}}"
if [[ -f $start ]]; then dump "$start" 0; else dump "$(system_table)" 0; fi
